+def test_explan_optimizer_populate_model(mock_data_handler):
+    optimizer = ExplanOptimizer(mock_data_handler, solver={'solver': 'cbc'})
+
+    optimizer.instantiate_model()
+    optimizer.populate_model()
+
+    model = optimizer.model
+    # Check if parameters were set
+    assert hasattr(model, 'load_full')
+    assert hasattr(model, 'P_cap')
+    assert hasattr(model, 'G_cc')
+
+    # Check if variables were set
+    assert hasattr(model, 'P_gen')
+    assert hasattr(model, 'P_cap_total')
+
+    # Check if constraints were added (via ExplanConstraints)
+    assert any(isinstance(c, pm.Constraint) for c in model.component_objects())
+
+def test_explan_optimizer_params_mapping(mock_data_handler):
